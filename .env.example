# Public proxy URL only. NEVER place the Navasan key in a WXT_ or VITE_ variable.
# Leave empty until a legitimate market proxy is configured.
WXT_MARKET_API_URL=

# Public browser map key only. Neshan SERVICE keys belong in server user-secrets.
WXT_NESHAN_MAP_KEY=

# Public browser key restricted to Maps Embed API. Rebuild after changing.
WXT_GOOGLE_MAPS_EMBED_KEY=

# Google OAuth client of type Chrome Extension, registered to the extension ID.
# Public client ID only; NEVER put a client secret here.
WXT_GOOGLE_OAUTH_CLIENT_ID=
